# GestCompta Backend Configuration
# Copier ce fichier en .env et remplir les valeurs réelles

# Firebase Configuration
FIREBASE_DATABASE_URL=https://votre-project.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Flask Configuration
FLASK_ENV=production
PORT=5000

# JWT Secret (pour authentification future)
JWT_SECRET=votre-clé-secrète-très-longue-et-complexe-de-minimum-32-caractères

# Logging
LOG_LEVEL=INFO

# CORS Configuration (domaines autorisés)
CORS_ORIGINS=https://gestcompta.web.app,https://localhost:3000

# Database Backup
ENABLE_BACKUPS=false
BACKUP_INTERVAL=86400
